msgid "Email address"
msgstr "E-Mail-Adresse"

msgid "Sex"
msgstr "Geschlecht"

msgid "Decides which tournaments you can enter."
msgstr "Bestimmt, für welche Wettbewerbe du dich melden kannst."

msgid "This address is already registered. Please log in instead."
msgstr ""
"Diese Adresse ist bereits registriert. Bitte melde dich stattdessen an."

msgid "Login code"
msgstr "Anmeldecode"

msgid "Male"
msgstr "Männlich"

msgid "Female"
msgstr "Weiblich"

