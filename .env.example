# Copy to .env and adjust. `just` loads this file automatically.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=liga.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://liga.example.org
DJANGO_TIME_ZONE=Europe/Berlin
# DJANGO_DB_PATH=/var/lib/klubliga/db.sqlite3

LOCAL_ENV=0
EMAIL_HOST=smtp.example.org
EMAIL_PORT=465
EMAIL_HOST_USER=klubliga@example.org
EMAIL_HOST_PASSWORD=secret
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL="Klubliga <klubliga@example.org>"

# gunicorn
HOST=127.0.0.1
PORT=8000
WORKERS=2
